(rule
 (alias runtest)
 (deps
  (sandbox none)
  (source_tree .))
 (action
  (bash "set -euo pipefail
work=$(mktemp -d)
trap 'rm -rf \"$work\"' EXIT
cp -LR . \"$work/tests\"
chmod -R u+w \"$work/tests\"
cd \"$work/tests\"
make -B all COQC=\"%{bin:rocq} c\"")))

(alias
 (name extraction)
 (deps (alias runtest)))
