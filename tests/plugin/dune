(rule
 (alias runtest)
 (deps
  (sandbox always)
  (source_tree .)
  ../../coq-hammer.install
  ../../coq-hammer-tactics.install)
 (action
  (bash "set -euo pipefail
root=%{workspace_root}
export COQPATH=\"$root/_build/install/default/lib/coq/user-contrib${COQPATH:+:$COQPATH}\"
export OCAMLPATH=\"$root/_build/install/default/lib${OCAMLPATH:+:$OCAMLPATH}\"
export PATH=\"$root/_build/install/default/bin:$PATH\"
work=$(mktemp -d)
trap 'rm -rf \"$work\"' EXIT
cp -LR . \"$work/tests\"
chmod -R u+w \"$work/tests\"
cd \"$work/tests\"
make -B all COQC='%{bin:rocq} c'")))

(alias
 (name extraction)
 (deps (alias runtest)))
