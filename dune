(env
 (dev
  (flags
   (:standard -w -27 -w -3))))

(rule
 (targets predict.bin)
 (deps
  (sandbox always)
  (source_tree src/predict))
 (action
  (run c++ -std=c++11 -DCOQ_MODE -O2 -Wall src/predict/main.cpp -o predict.bin)))

(rule
 (targets htimeout.bin)
 (deps
  (sandbox always)
  (source_tree src/htimeout))
 (action
  (run cc -O2 -Wall src/htimeout/htimeout.c -o htimeout.bin)))

(install
 (files
  (predict.bin as predict)
  (htimeout.bin as htimeout))
 (section bin)
 (package coq-hammer))
